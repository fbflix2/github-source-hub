{
  "manifest_version": 3,
  "name": "FBFlix - Captura de Amigos",
  "version": "1.0.0",
  "description": "Captura automaticamente nome e quantidade de amigos ao abrir perfis do Facebook.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://mxnlerkeygfvdnznoxld.supabase.co/*"
  ],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}